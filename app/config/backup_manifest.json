  "exclusions": [
    {
      "path": "app/data/ops/backup_status_latest.json",
      "reason": "The backup's own status marker \u2014 backing it up would make backup state part of the protected payload and churn every run."
    },
    {
      "path": "app/data/ops/backup_staging",
      "reason": "Transient staging directory cleaned every run; contents are copies of already-covered sources."
    },
    {
      "path": "app/data/assets/",
      "reason": "Rebuildable from public Sleeper CDN; not irreplaceable (Increment-0 spec s1A)."
    },
    {
      "path": "app/data/league_transactions.db",
      "reason": "Rebuildable from public Sleeper API; not irreplaceable."
    },
    {
      "path": "app/data/sources/nfl_nextgen_stats/",
      "reason": "Rebuildable from public NFL Next Gen Stats via nflreadpy; not irreplaceable."
    },
    {
      "path": "app/data/sources/cfbd_foundation/",
      "reason": "Rebuildable from collegefootballdata.com API via run_cfbd_foundation_refresh.py; not irreplaceable."
    },
    {
      "path": "app/data/nflverse_usage.db",
      "reason": "Ledger content re-derives from the raw vintage snapshots plus pinned parsers (replay receipt replay-20260829T143201Z: 14/14 nflverse checks reproduced), and the raw tree is protected offsite by the DG-100 incremental channel (scripts/backup_nflverse_vintages.py). The pre-2026-08-29 rationale ('rebuildable from public nflverse') covered only CURRENT content, not the dated vintages — superseded by DG-100."
    },
    {
      "path": "app/data/nflverse_usage/raw/",
      "reason": "The vintage snapshot record (point-in-time captures). Protected offsite by the DG-100 incremental additive channel — scripts/backup_nflverse_vintages.py, one stable prefix at gs://dynasty-genius-backup-dtl/dynasty-genius/nflverse-vintages/raw, run receipts at app/data/ops/nflverse_vintage_backup_status.json. Excluded from the NIGHTLY full-re-upload channel only: including 30GB there would 4x the nightly payload, run past the 10:30 alert's marker read, and grow the append-only bucket by the tree's full size daily (DG-100 decision, David's 2026-08-29 delegation)."
    },
    {
      "path": "app/data/nflverse_usage/export/",
      "reason": "Per-run parquet exports (701MB 2026-08-29), regenerated by every run_nflverse_usage_capture.py run from nflverse_usage.db — which itself re-derives from the raw/ vintages that DG-100's channel protects. Derived twice over; not irreplaceable. Scoped explicitly rather than under a parent-directory exclusion so a future store dropped beside it stays visible to the anti-rot large-tree sweep (the DG-100 blind spot)."
    },
    {
      "path": "app/data/nflverse_usage/nflverse_usage_status_latest.json",
      "reason": "Capture status marker — rewritten by every 06:15 run and read by the catch-up guard; backing up a liveness receipt would make capture state part of the protected payload (same rationale as the backup runner's own marker)."
    }
  ]
}
